# Inferred from src/db/index.ts + src/scripts + dummy_T3 T3 base
# Copy to .env and fill real values. Never commit .env.

# Primary Mongo connection used by Mongoose (src/db/index.ts)
MONGODB_URI="mongodb://localhost:27017/alms_logistics"

# Prisma datasource (prisma/schema.prisma). Can be same cluster as above.
DATABASE_URL="mongodb://localhost:27017/alms_logistics"

# NextAuth / T3 compat (optional in dev, required in prod via src/env.js)
AUTH_SECRET="dev-secret-change-me"

NODE_ENV="development"
PORT="3000"
SKIP_ENV_VALIDATION=""

# Client-side (optional, NEXT_PUBLIC_ prefix)
# NEXT_PUBLIC_MAP_TILES_URL=""

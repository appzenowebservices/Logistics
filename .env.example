# Copy to .env and fill real values. Never commit .env.
# Docker compose + Prisma + Mongoose all read DATABASE_URL.
# MONGODB_URI is an optional alias (defaults to DATABASE_URL).

# Primary Mongo connection (Prisma datasource + Mongoose + compose)
DATABASE_URL="mongodb://localhost:27017/alms_logistics"

# Backwards-compat alias for src/db + scripts (optional)
MONGODB_URI="mongodb://localhost:27017/alms_logistics"

# T3 compat (optional in dev, required in prod via src/env.js)
AUTH_SECRET="dev-secret-change-me"

NODE_ENV="development"
PORT="3000"
SKIP_ENV_VALIDATION=""

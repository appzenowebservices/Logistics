{
  "name": "alms-logistics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ADDies Logistics Management System (ALMS) - T3 + Mongoose + Prisma",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:init": "tsx src/scripts/init-db.ts",
    "db:flush": "tsx src/scripts/flush-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "mongoose": "^8.17.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.4.31",
    "prisma": "^6.17.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "packageManager": "npm@11.1.0"
}
